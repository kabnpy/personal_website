---
import AmbientLayers from '../components/AmbientLayers.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
  currentPath?: string;
  highlightContact?: boolean;
}

const {
  title,
  description,
  isHome = false,
  currentPath = '/',
  highlightContact = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('color-scheme');
        if (saved === 'light' || saved === 'dark') {
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.content = saved;
        }
      } catch {}
    </script>
    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cstyle%3Erect%7Bfill:%230a0a0a%7D@media(prefers-color-scheme:dark)%7Brect%7Bfill:%23f5f5f5%7D%7D%3C/style%3E%3Crect x='3' y='3' width='6' height='18'/%3E%3Crect x='11' y='15' width='10' height='6'/%3E%3Crect x='15' y='3' width='6' height='6'/%3E%3C/svg%3E"
    />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <AmbientLayers />

    <div class="frame">
      <SiteHeader isHome={isHome} currentPath={currentPath} />

      <slot />

      <SiteFooter highlightContact={highlightContact} />
    </div>

    <script>
      import '../scripts/shadows.js';
      import '../scripts/theme.js';
      import '../scripts/copy-email.js';
    </script>
    <slot name="scripts" />
  </body>
</html>
