---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Maren Lind"
  description="Contact Maren Lind: send a message, copy email, download resume, or find links elsewhere."
  currentPath="/contact"
  highlightContact={true}
>
  <main class="page-main stack" data-gap="xl">
    <section class="page-header reveal" style="--reveal-order: 1">
      <div class="page-header__title-group">
        <h1 class="display-title">Contact</h1>
        <p class="mono-label text-muted">replies within one working day</p>
      </div>
      <p class="page-header__summary">
        For work, collaboration, or just to say hello.
      </p>
    </section>

    <div class="contact-grid">
      <div class="contact-grid__content stack" data-gap="xl">
        <section class="reveal" style="--reveal-order: 2" aria-labelledby="message-heading">
          <div class="section-label">
            <h2 id="message-heading" class="section-label__title mono-label text-muted">send a note</h2>
          </div>

          <form
            id="contact-form"
            class="contact-form"
            action="mailto:hello@example.com"
            method="post"
            enctype="text/plain"
            novalidate
          >
            <div class="field">
              <label for="contact-name" class="mono-label text-muted">name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                class="field__input"
                placeholder="Your name"
                autocomplete="name"
                required
                aria-describedby="contact-name-error"
              />
              <p id="contact-name-error" class="field__error"></p>
            </div>

            <div class="field">
              <label for="contact-email" class="mono-label text-muted">email</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                class="field__input"
                placeholder="you@example.com"
                autocomplete="email"
                required
                aria-describedby="contact-email-error"
              />
              <p id="contact-email-error" class="field__error"></p>
            </div>

            <div class="field">
              <label for="contact-message" class="mono-label text-muted">message</label>
              <textarea
                id="contact-message"
                name="message"
                class="field__input field__textarea"
                placeholder="What are you working on?"
                rows="4"
                required
                aria-describedby="contact-message-error"
              ></textarea>
              <p id="contact-message-error" class="field__error"></p>
            </div>

            <div class="contact-form__actions">
              <button type="submit" class="enter-link form-submit">
                Send message <span class="enter-link__arrow" aria-hidden="true">→</span>
              </button>
              <p id="contact-form-status" class="form-status" aria-live="polite"></p>
            </div>
          </form>
        </section>

        <section class="reveal" style="--reveal-order: 3" aria-labelledby="email-heading">
          <div class="section-label">
            <h2 id="email-heading" class="section-label__title mono-label text-muted">email</h2>
            <p class="mono-label text-muted" style="margin: 0;">click to copy</p>
          </div>
          <a
            href="mailto:hello@example.com"
            class="contact-email"
            data-copy-email="hello@example.com"
            title="Copy hello@example.com"
          >
            hello@example.com
          </a>
        </section>

        <section class="reveal" style="--reveal-order: 4" aria-labelledby="resume-heading">
          <div class="section-label">
            <h2 id="resume-heading" class="section-label__title mono-label text-muted">resume</h2>
          </div>
          <ul class="link-list" role="list">
            <li>
              <a class="link-row" href="/resume.pdf" download>
                <span class="mono-label text-muted">pdf</span>
                <span>Download my resume</span>
                <span class="mono-label text-muted" aria-hidden="true">↓</span>
              </a>
            </li>
          </ul>
        </section>

        <section class="reveal" style="--reveal-order: 5" aria-labelledby="elsewhere-heading">
          <div class="section-label">
            <h2 id="elsewhere-heading" class="section-label__title mono-label text-muted">elsewhere</h2>
          </div>
          <ul class="link-list" role="list">
            <li>
              <a class="link-row" href="https://github.com/your-handle" rel="me noopener">
                <span class="mono-label text-muted">github</span>
                <span>github.com/your-handle</span>
                <span class="mono-label text-muted" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a class="link-row" href="https://www.linkedin.com/in/your-handle" rel="me noopener">
                <span class="mono-label text-muted">linkedin</span>
                <span>linkedin.com/in/your-handle</span>
                <span class="mono-label text-muted" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import '../scripts/contact-form.js';
</script>
