---
interface MetaItem {
  label: string;
  value: string;
}

interface Project {
  index: string;
  title: string;
  discipline: string;
  year: string;
  description: string;
  meta: MetaItem[];
}

interface Props {
  project: Project;
  revealOrder: number;
}

const { project, revealOrder } = Astro.props;
const { index, title, discipline, year, description, meta } = project;
---

<details class="specimen-row reveal" style={`--reveal-order: ${revealOrder}`}>
  <summary class="specimen-row__summary">
    <span class="specimen-row__index mono-label text-muted">{index}</span>
    <span class="specimen-row__title">{title}</span>
    <span class="specimen-row__discipline mono-label text-muted">{discipline}</span>
    <span class="specimen-row__year mono-label text-muted">{year}</span>
  </summary>
  <div class="specimen-row__body">
    <p class="specimen-row__desc">{description}</p>
    <dl class="specimen-meta">
      {
        meta.map((item) => (
          <div>
            <dt class="mono-label text-muted">{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</details>
